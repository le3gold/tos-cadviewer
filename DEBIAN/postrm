#!/bin/bash
# TOS 7 post-remove script for CAD Viewer.
#
# Purge removes what the package installed. It deliberately does NOT touch
# /Volume*/CADViewer: that holds the user's own models, and guide 12 says
# application data in a shared folder is never deleted automatically.
set -e

APPID="le3gold-cadviewer"
DATA_ROOT="/var/lib/${APPID}"

if [ "$1" = "purge" ]; then
    if [ -f "${DATA_ROOT}/install.log" ]; then
        echo "$(date '+%F %T') purging ${APPID}" >> "${DATA_ROOT}/install.log" 2>/dev/null || true
    fi

    # ACL entries this package added, removed so the volume does not keep
    # granting an account that no longer exists. tmacltool modifies entries
    # with `add`/`modify`/`del`; there is no `!name` shorthand (measured on
    # TOS 7.0.1201: modify rejects "!user:<id>" with "invalid ace format").
    # The entry text has to repeat the permission and inheritance fields.
    if command -v tmacltool >/dev/null 2>&1; then
        for VOL in /Volume[0-9]*; do
            [ -d "${VOL}" ] || continue
            tmacltool del "${VOL}" "user:${APPID}:allow:r-x:--" >/dev/null 2>&1 || true
        done
    fi

    rm -f "/etc/nginx/conf.d/${APPID}.conf" 2>/dev/null || true
    rm -f "/etc/systemd/system/${APPID}.service" 2>/dev/null || true
    rm -rf "${DATA_ROOT}" 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl reload nginx 2>/dev/null || true
fi

exit 0
