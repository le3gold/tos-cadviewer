# CAD Viewer - environment configuration
# Loaded by systemd via EnvironmentFile=/usr/local/le3gold-cadviewer/le3gold-cadviewer.env

# Backend listen address. Must stay 0.0.0.0 so the app is reachable from the LAN.
LISTEN_HOST=0.0.0.0

# Backend listen port. Must match the port used in config.ini "path" and in
# nginx/le3gold-cadviewer.conf. Change all three together if 8686 is already taken.
LISTEN_PORT=8686

# Directory served to the browser (extracted from webui.bz2 at install time).
WEBUI_DIR=/usr/local/le3gold-cadviewer/webui

# URL prefix served by nginx in front of this backend.
URL_PREFIX=/le3gold-cadviewer

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
