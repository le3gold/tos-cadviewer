# CAD Viewer - environment configuration.
# DEBIAN/postinst copies this file into /var/lib/le3gold-cadviewer/runtime/,
# which is where systemd reads it from (EnvironmentFile=).

# Backend listen address. The guide (8.3.2, "Port Listening Rules") requires
# the backend to listen on 0.0.0.0; the portal route in
# nginx/le3gold-cadviewer.conf is the supported entry point.
LISTEN_HOST=0.0.0.0

# Backend listen port. Must match the port in nginx/le3gold-cadviewer.conf.
# The platform reserves 22, 80, 443, 8181 and 5050; the recommended range is
# 8000-19999. 17868 is outside the ranges other TOS applications commonly use.
LISTEN_PORT=17868

# Directory served to the browser. Deliberately outside /Volume*/@apps: tmacl
# denies the unprivileged service account every path under a volume, including
# its own install tree. postinst stages the web UI here.
WEBUI_DIR=/var/lib/le3gold-cadviewer/runtime/webui

# URL prefix served by nginx in front of this backend. Must match config.ini's
# "path" field and the nginx location block.
URL_PREFIX=/le3gold-cadviewer

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
