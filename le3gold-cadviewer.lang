[en-us]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "View and inspect 3D models and CAD files directly in your browser, with nothing uploaded to the cloud. Supports STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF and AMF. All parsing runs locally on your TNAS and no internet connection is required."
release_note = "1. Importing from the NAS now lists only the folders that belong to this application: the shared folders the administrator granted to the application's user in Control Panel &gt; Shared Folders &gt; Permissions &gt; Application users, plus your own personal folder.</br>2. Every other shared folder is hidden, so the picker no longer offers the whole NAS.</br>3. Granting or revoking a folder for the application's user is picked up immediately, with no reinstall and no restart.</br>4. A normal user reaches those folders once the administrator grants that user access to them as well."
important = "Uses TCP port 17868 on your TNAS. Make sure this port is not occupied by another application. Do not expose this port to the internet."

[zh-cn]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "在浏览器中直接查看和检查三维模型与 CAD 文件，文件不会被上传到云端。支持 STEP、IGES、BREP、IFC、STL、OBJ、PLY、3MF、GLTF/GLB、FBX、DAE、3DS、WRL、OFF、AMF 等格式。所有解析均在本机 TNAS 本地完成，无需联网。"
release_note = "1. 从 NAS 导入现在只列出属于本应用的文件夹：管理员在「控制面板 &gt; 共享文件夹 &gt; 权限 &gt; 应用用户」中授予本应用账号的共享文件夹，以及你自己的个人文件夹。</br>2. 其余共享文件夹不再出现，选择器不会再列出整个 NAS。</br>3. 在平台上给应用用户授予或撤销文件夹后会立即生效，无需重装或重启应用。</br>4. 普通用户还需要管理员在同一个权限窗口中为其授权，才能看到并使用这些文件夹。"
important = "本应用占用 TNAS 的 TCP 17868 端口，请确认该端口未被其他应用占用。请勿将该端口暴露到公网。"

[zh-hk]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "在瀏覽器中直接檢視三維模型與 CAD 檔案，檔案不會上傳到雲端。支援 STEP、IGES、BREP、IFC、STL、OBJ、PLY、3MF、GLTF/GLB、FBX、DAE、3DS、WRL、OFF、AMF 等格式。所有解析均在本機 TNAS 本地完成，無需連線網路。"
release_note = "1. 從 NAS 匯入現在只列出屬於本應用程式的資料夾：管理員在「控制台 &gt; 共享資料夾 &gt; 權限 &gt; 應用程式使用者」中授予本應用程式帳號的共享資料夾，以及你自己的個人資料夾。</br>2. 其餘共享資料夾不再出現，選擇器不會再列出整個 NAS。</br>3. 在平台上為應用程式使用者授予或撤銷資料夾後會立即生效，無需重新安裝或重新啟動應用程式。</br>4. 一般使用者還需要管理員在同一個權限視窗中授權，才能看到並使用這些資料夾。"
important = "本應用佔用 TNAS 的 TCP 17868 連接埠，請確認該連接埠未被其他應用佔用。請勿將該連接埠暴露到公網。"

[fr-fr]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Affichez et inspectez des modèles 3D et des fichiers CAO directement dans votre navigateur, sans rien envoyer dans le cloud. Prend en charge les formats STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF et AMF. Toute l'analyse est effectuée localement sur votre TNAS, sans connexion Internet."
release_note = "1. L'import depuis le NAS ne liste plus que les dossiers qui appartiennent à cette application : les dossiers partagés que l'administrateur a accordés au compte de l'application dans Panneau de configuration &gt; Dossiers partagés &gt; Autorisations &gt; Utilisateurs d'application, ainsi que votre dossier personnel.</br>2. Les autres dossiers partagés n'apparaissent plus : le sélecteur ne propose donc plus tout le NAS.</br>3. Accorder ou retirer un dossier à l'utilisateur de l'application est pris en compte immédiatement, sans réinstallation ni redémarrage.</br>4. Un utilisateur standard accède à ces dossiers dès que l'administrateur lui en accorde aussi l'accès."
important = "Utilise le port TCP 17868 de votre TNAS. Vérifiez que ce port n'est pas occupé par une autre application. N'exposez pas ce port sur Internet."

[de-de]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Zeigen und prüfen Sie 3D-Modelle und CAD-Dateien direkt im Browser, ohne etwas in die Cloud hochzuladen. Unterstützt STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF und AMF. Die gesamte Verarbeitung erfolgt lokal auf Ihrem TNAS, eine Internetverbindung ist nicht erforderlich."
release_note = "1. Der Import vom NAS listet nur noch die Ordner dieser Anwendung auf: die freigegebenen Ordner, die der Administrator dem Benutzer der Anwendung unter Systemsteuerung &gt; Freigegebene Ordner &gt; Berechtigungen &gt; Anwendungsbenutzer zugewiesen hat, sowie Ihren persönlichen Ordner.</br>2. Alle anderen freigegebenen Ordner erscheinen nicht mehr, die Auswahl zeigt also nicht mehr das gesamte NAS.</br>3. Das Zuweisen oder Entziehen eines Ordners für den Anwendungsbenutzer wirkt sofort, ohne Neuinstallation und ohne Neustart.</br>4. Ein normaler Benutzer erreicht diese Ordner, sobald der Administrator ihm ebenfalls Zugriff gewährt."
important = "Belegt den TCP-Port 17868 auf Ihrem TNAS. Stellen Sie sicher, dass dieser Port nicht von einer anderen Anwendung verwendet wird. Geben Sie diesen Port nicht im Internet frei."

[it-it]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Visualizza e ispeziona modelli 3D e file CAD direttamente nel browser, senza caricare nulla sul cloud. Supporta STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF e AMF. Tutta l'elaborazione avviene localmente sul TNAS e non richiede connessione a Internet."
release_note = "1. L'importazione dal NAS elenca ora solo le cartelle di questa applicazione: le cartelle condivise che l'amministratore ha concesso all'utente dell'applicazione in Pannello di controllo &gt; Cartelle condivise &gt; Autorizzazioni &gt; Utenti applicazione, più la cartella personale.</br>2. Tutte le altre cartelle condivise non compaiono più, quindi il selettore non propone più l'intero NAS.</br>3. Concedere o revocare una cartella all'utente dell'applicazione ha effetto immediato, senza reinstallare e senza riavviare.</br>4. Un utente normale vede queste cartelle solo dopo che l'amministratore gli ha concesso l'accesso."
important = "Utilizza la porta TCP 17868 del TNAS. Verificare che la porta non sia occupata da un'altra applicazione. Non esporre questa porta su Internet."

[es-es]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Vea e inspeccione modelos 3D y archivos CAD directamente en el navegador, sin subir nada a la nube. Compatible con STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF y AMF. Todo el procesamiento se realiza localmente en su TNAS y no requiere conexión a Internet."
release_note = "1. Importar desde el NAS ahora solo muestra las carpetas de esta aplicación: las carpetas compartidas que el administrador concedió al usuario de la aplicación en Panel de control &gt; Carpetas compartidas &gt; Permisos &gt; Usuarios de aplicación, además de tu carpeta personal.</br>2. El resto de carpetas compartidas ya no aparece, así que el selector ya no ofrece todo el NAS.</br>3. Conceder o revocar una carpeta al usuario de la aplicación se aplica de inmediato, sin reinstalar ni reiniciar.</br>4. Un usuario normal accede a esas carpetas cuando el administrador también le concede permiso."
important = "Utiliza el puerto TCP 17868 de su TNAS. Compruebe que este puerto no esté ocupado por otra aplicación. No exponga este puerto a Internet."

[hu-hu]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "A 3D modelleket és CAD fájlokat közvetlenül a böngészőben tekintheti meg és vizsgálhatja, feltöltés a felhőbe nem történik. Támogatott formátumok: STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF és AMF. A feldolgozás teljes egészében helyben, az Ön TNAS eszközén történik, internetkapcsolat nem szükséges."
release_note = "1. A NAS-ról történő importálás már csak az alkalmazáshoz tartozó mappákat listázza: azokat a megosztott mappákat, amelyeket a rendszergazda az alkalmazás felhasználójának adott a Vezérlőpult &gt; Megosztott mappák &gt; Jogosultságok &gt; Alkalmazásfelhasználók menüben, valamint a saját személyes mappádat.</br>2. Minden más megosztott mappa eltűnik, így a választó már nem kínálja a teljes NAS-t.</br>3. A mappa odaítélése vagy visszavonása azonnal érvényesül, újratelepítés és újraindítás nélkül.</br>4. Egy egyszerű felhasználó akkor éri el ezeket a mappákat, ha a rendszergazda neki is jogosultságot ad."
important = "A TNAS 17868-as TCP portját használja. Győződjön meg arról, hogy ezt a portot nem használja más alkalmazás. Ne tegye közzé ezt a portot az interneten."

[ja-jp]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "ブラウザから直接 3D モデルや CAD ファイルを表示・確認できます。ファイルはクラウドに送信されません。STEP、IGES、BREP、IFC、STL、OBJ、PLY、3MF、GLTF/GLB、FBX、DAE、3DS、WRL、OFF、AMF に対応しています。解析はすべて TNAS 上でローカルに実行され、インターネット接続は不要です。"
release_note = "1. NAS からの読み込みでは、このアプリに属するフォルダーだけが表示されます。管理者が「コントロールパネル &gt; 共有フォルダー &gt; 権限 &gt; アプリケーションユーザー」でアプリのユーザーに許可した共有フォルダーと、あなた自身の個人フォルダーです。</br>2. それ以外の共有フォルダーは表示されなくなり、選択画面に NAS 全体が並ぶことはありません。</br>3. アプリケーションユーザーへのフォルダーの許可・取り消しは、再インストールや再起動なしで即座に反映されます。</br>4. 一般ユーザーは、管理者が同じ権限画面でそのユーザーにも許可したうえで利用できます。"
important = "TNAS の TCP ポート 17868 を使用します。このポートが他のアプリケーションで使用されていないことを確認してください。このポートをインターネットに公開しないでください。"

[ko-kr]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "브라우저에서 바로 3D 모델과 CAD 파일을 확인할 수 있으며 파일은 클라우드로 전송되지 않습니다. STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF, AMF 형식을 지원합니다. 모든 변환은 TNAS에서 로컬로 처리되며 인터넷 연결이 필요하지 않습니다."
release_note = "1. NAS에서 가져오기는 이제 이 앱에 속한 폴더만 표시합니다. 관리자가 제어판 &gt; 공유 폴더 &gt; 권한 &gt; 애플리케이션 사용자에서 앱 사용자에게 부여한 공유 폴더와 본인의 개인 폴더입니다.</br>2. 다른 공유 폴더는 더 이상 표시되지 않으므로 선택 화면에 NAS 전체가 나열되지 않습니다.</br>3. 애플리케이션 사용자에게 폴더를 부여하거나 취소하면 재설치나 재시작 없이 즉시 반영됩니다.</br>4. 일반 사용자는 관리자가 같은 권한 창에서 해당 사용자에게도 권한을 부여한 뒤에 사용할 수 있습니다."
important = "TNAS의 TCP 포트 17868을 사용합니다. 이 포트가 다른 응용 프로그램에서 사용 중이지 않은지 확인하십시오. 이 포트를 인터넷에 노출하지 마십시오."

[pl-pl]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Przeglądaj i analizuj modele 3D oraz pliki CAD bezpośrednio w przeglądarce — nic nie jest wysyłane do chmury. Obsługiwane formaty: STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF i AMF. Całe przetwarzanie odbywa się lokalnie na Twoim TNAS i nie wymaga połączenia z Internetem."
release_note = "1. Import z NAS wyświetla teraz tylko foldery należące do tej aplikacji: foldery udostępnione przyznane użytkownikowi aplikacji przez administratora w Panelu sterowania &gt; Foldery udostępnione &gt; Uprawnienia &gt; Użytkownicy aplikacji, oraz Twój folder osobisty.</br>2. Pozostałe foldery udostępnione nie są już pokazywane, więc wybór nie oferuje całego NAS-a.</br>3. Przyznanie lub odebranie folderu użytkownikowi aplikacji działa natychmiast, bez reinstalacji i restartu.</br>4. Zwykły użytkownik uzyska dostęp do tych folderów, gdy administrator przyzna mu uprawnienia."
important = "Wykorzystuje port TCP 17868 w Twoim TNAS. Upewnij się, że port ten nie jest zajęty przez inną aplikację. Nie udostępniaj tego portu w Internecie."

[ru-ru]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Просматривайте 3D-модели и CAD-файлы прямо в браузере, не загружая их в облако. Поддерживаются форматы STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF и AMF. Вся обработка выполняется локально на вашем TNAS, подключение к интернету не требуется."
release_note = "1. Импорт с NAS теперь показывает только папки, принадлежащие этому приложению: общие папки, которые администратор предоставил пользователю приложения в разделе Панель управления &gt; Общие папки &gt; Права &gt; Пользователи приложений, а также вашу личную папку.</br>2. Остальные общие папки больше не отображаются, поэтому в списке нет всего NAS.</br>3. Выдача или отзыв папки для пользователя приложения применяется сразу, без переустановки и перезапуска.</br>4. Обычный пользователь получит доступ к этим папкам после того, как администратор предоставит права и ему."
important = "Использует TCP-порт 17868 на вашем TNAS. Убедитесь, что этот порт не занят другим приложением. Не открывайте этот порт в интернет."

[tr-tr]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "3B modelleri ve CAD dosyalarını doğrudan tarayıcınızda görüntüleyin ve inceleyin; hiçbir şey buluta yüklenmez. STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF ve AMF desteklenir. Tüm işleme TNAS cihazınızda yerel olarak yapılır ve internet bağlantısı gerekmez."
release_note = "1. NAS'tan içe aktarma artık yalnızca bu uygulamaya ait klasörleri listeler: yöneticinin Denetim Masası &gt; Paylaşılan klasörler &gt; İzinler &gt; Uygulama kullanıcıları bölümünde uygulamanın kullanıcısına verdiği paylaşılan klasörler ve kendi kişisel klasörünüz.</br>2. Diğer paylaşılan klasörler artık görünmez, bu nedenle seçici tüm NAS'ı sunmaz.</br>3. Uygulama kullanıcısına klasör verilmesi veya geri alınması yeniden kurulum ve yeniden başlatma olmadan hemen geçerli olur.</br>4. Normal bir kullanıcı bu klasörlere, yönetici ona da izin verdiğinde erişir."
important = "TNAS cihazınızda TCP 17868 portunu kullanır. Bu portun başka bir uygulama tarafından kullanılmadığından emin olun. Bu portu internete açmayın."

[pt-pt]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "Veja e inspecione modelos 3D e ficheiros CAD diretamente no navegador, sem enviar nada para a nuvem. Suporta STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF e AMF. Todo o processamento é feito localmente no seu TNAS e não requer ligação à Internet."
release_note = "1. A importação do NAS passa a listar apenas as pastas desta aplicação: as pastas partilhadas que o administrador atribuiu ao utilizador da aplicação em Painel de Controlo &gt; Pastas partilhadas &gt; Permissões &gt; Utilizadores de aplicação, mais a sua pasta pessoal.</br>2. As restantes pastas partilhadas deixam de aparecer, pelo que o seletor já não mostra o NAS inteiro.</br>3. Atribuir ou retirar uma pasta ao utilizador da aplicação tem efeito imediato, sem reinstalar nem reiniciar.</br>4. Um utilizador comum só acede a essas pastas depois de o administrador lhe conceder também a permissão."
important = "Utiliza a porta TCP 17868 do seu TNAS. Certifique-se de que esta porta não está ocupada por outra aplicação. Não exponha esta porta à Internet."

