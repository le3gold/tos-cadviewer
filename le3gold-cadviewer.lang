[en-us]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "View and inspect 3D models and CAD files directly in your browser, with nothing uploaded to the cloud. Supports STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF and AMF. All parsing runs locally on your TNAS and no internet connection is required."
release_note = "1. Import a model straight from the shared folders on the NAS, without downloading it to your computer first.</br>2. The import button now offers a choice: this computer or the NAS."
important = "Uses TCP port 8686 on your TNAS. Make sure this port is not occupied by another application. Do not expose this port to the internet."

[zh-cn]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "在浏览器中直接查看和检查三维模型与 CAD 文件，文件不会被上传到云端。支持 STEP、IGES、BREP、IFC、STL、OBJ、PLY、3MF、GLTF/GLB、FBX、DAE、3DS、WRL、OFF、AMF 等格式。所有解析均在本机 TNAS 本地完成，无需联网。"
release_note = "1. 可以直接从 NAS 的共享文件夹导入模型，不必先下载到电脑再上传。</br>2. 导入按钮现在提供两个选项：从电脑导入、从 NAS 导入。"
important = "本应用占用 TNAS 的 TCP 8686 端口，请确认该端口未被其他应用占用。请勿将该端口暴露到公网。"

[zh-hk]
