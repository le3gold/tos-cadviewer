[en-us]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "View and inspect 3D models and CAD files directly in your browser, with nothing uploaded to the cloud. Supports STEP, IGES, BREP, IFC, STL, OBJ, PLY, 3MF, GLTF/GLB, FBX, DAE, 3DS, WRL, OFF and AMF. All parsing runs locally on your TNAS and no internet connection is required."
release_note = "1. The app now runs as its own non-root account and opens through the App Center portal route, as the store review requires.</br>2. The backend moved to TCP port 17868.</br>3. A privacy policy is now included (see PRIVACY.md): the app sends no data anywhere.</br>4. The description, the important notes and the release notes are now translated into all 14 store languages.</br>5. Importing a model from the NAS now lists the folders of the signed-in user: the platform's own file service answers, so every account sees and opens only what it is allowed to."
important = "Uses TCP port 17868 on your TNAS. Make sure this port is not occupied by another application. Do not expose this port to the internet."

[zh-cn]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "在浏览器中直接查看和检查三维模型与 CAD 文件，文件不会被上传到云端。支持 STEP、IGES、BREP、IFC、STL、OBJ、PLY、3MF、GLTF/GLB、FBX、DAE、3DS、WRL、OFF、AMF 等格式。所有解析均在本机 TNAS 本地完成，无需联网。"
release_note = "1. 应用改用独立的非 root 账号运行，并按商店审核要求通过应用中心门户路由打开。</br>2. 后端服务改用 TCP 17868 端口。</br>3. 新增隐私政策（见 PRIVACY.md）：应用不会把数据发送到任何地方。</br>4. 应用说明、重要提示与更新说明已翻译为商店支持的全部 14 种语言。</br>5. 从 NAS 导入时，现在按当前登录用户的权限列出文件夹：由平台的文件服务应答，每个账号只能看到并打开自己有权限的内容。"
important = "本应用占用 TNAS 的 TCP 17868 端口，请确认该端口未被其他应用占用。请勿将该端口暴露到公网。"

[zh-hk]
name = "CAD Viewer"
auth = "Viktor Kovacs"
descript = "在瀏覽器中直接檢視三維模型與 CAD 檔案，檔案不會上傳到雲端。支援 STEP、IGES、BREP、IFC、STL、OBJ、PLY、3MF、GLTF/GLB、FBX、DAE、3DS、WRL、OFF、AMF 等格式。所有解析均在本機 TNAS 本地完成，無需連線網路。"
