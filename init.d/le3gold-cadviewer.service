[Unit]
Description=CAD Viewer Service
After=network.target

# Rate limiting is off on purpose.
#
# The platform runs DEBIAN/postinst BEFORE it creates the application account.
# On a fresh install the first start therefore dies with 217/USER ("Failed to
# determine user credentials"), and with the default policy (5 attempts inside
# 60 s) systemd declared the unit dead before the account appeared. Measured on
# TOS 7.0.1201:
#
#   19:13:06 systemd: Failed to determine user credentials (217/USER)
#   19:13:57 systemd: Start request repeated too quickly.
#
# The application only came up because it was installed a second time. With the
# limiter disabled the unit keeps retrying every RestartSec until the account
# exists, and the ExecStartPre hook below then repairs what postinst could not.
StartLimitIntervalSec=0

[Service]
Type=simple

# Dedicated unprivileged account, created by the platform from the "user"
# field in config.ini (guide 8.12 / 10.3). The name must match that field.
#
# The service deliberately does NOT run from /usr/local/<appid>. That path is
# a symlink into /Volume*/@apps/<appid>, and TerraMaster's rich ACL ("tmacl",
# the btrfs mount option behind /Volume*) is deny-by-default at EVERY
# directory level, so an unprivileged process cannot even read its own binary
# there. Measured on a real TNAS running TOS 7.0.1201:
#
#   $ tmacltool get-perm /Volume1 <app uid>    -> max_permission: -------------
#   $ su -s /bin/sh <appid> -c 'ls /Volume1/@apps'
#     -> Permission denied        (the directory is mode 755; the POSIX bits
#                                  do not decide, the tmacl entries do)
#   $ su -s /bin/sh <appid> -c 'wc -c /usr/local/<appid>/bin/<appid>'
#     -> Permission denied
#
# DEBIAN/postinst therefore stages the executable and the web UI under
# /var/lib/<appid>/runtime - the system volume carries no tmacl entries - and
# owns that tree to this account. The staging copy is refreshed on every
# install, so an upgrade always runs the current build.
User=le3gold-cadviewer
Group=le3gold-cadviewer
WorkingDirectory=/var/lib/le3gold-cadviewer/runtime
ExecStart=/var/lib/le3gold-cadviewer/runtime/bin/le3gold-cadviewer
# The "-" prefix makes the file optional, so a missing one cannot take the
# unit down with it.
EnvironmentFile=-/var/lib/le3gold-cadviewer/runtime/le3gold-cadviewer.env
# Runs as root (the "+" prefix), because the repairs it makes - owning the
# staged runtime, joining allusers, granting tmacl entries - all name an account
# that does not exist yet when postinst runs. The "-" prefix keeps a missing
# helper from taking the service down; see usr/lib/<appid>/runtime-fixup.sh.
ExecStartPre=-+/usr/lib/le3gold-cadviewer/runtime-fixup.sh
TimeoutStartSec=30
TimeoutStopSec=10
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
UMask=0027
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native

# Read-write paths.
#
# /var/log is deliberately absent. On TOS 7 /var/log is a symlink to /tmp/log
# and /tmp is a tmpfs, so PrivateTmp=true below makes systemd resolve
# /var/log/<appid> to a path that does not exist inside the unit namespace.
# The unit then dies before ExecStart with 226/NAMESPACE ("Failed to set up
# mount namespacing"). The service logs to the journal through stdout, so it
# needs no writable log directory.
ReadWritePaths=/var/lib/le3gold-cadviewer

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
