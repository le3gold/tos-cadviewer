[Unit]
Description=CAD Viewer Service
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=le3gold-cadviewer
Group=le3gold-cadviewer
WorkingDirectory=/usr/local/le3gold-cadviewer
ExecStart=/usr/local/le3gold-cadviewer/bin/le3gold-cadviewer
EnvironmentFile=/usr/local/le3gold-cadviewer/le3gold-cadviewer.env
TimeoutStartSec=30
TimeoutStopSec=10
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native

# Read-write paths
ReadWritePaths=/var/lib/le3gold-cadviewer /var/log/le3gold-cadviewer

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
